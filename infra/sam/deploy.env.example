# export SQS_VPC_ENDPOINT_DNS=vpce-08bf80c705128a16d-01je7pwa.sqs.us-west-2.vpce.amazonaws.com
# Optional: force Lambda Invoke VPC endpoint subnet (Private DNS stays false)
# export LAMBDA_ENDPOINT_SUBNET_ID=subnet-0ddb23264a678e2dc

# Verified SES From address (must be verified in us-west-2)
# Bare verified address only (SAM parameter-overrides truncates display names).
export EMAIL_FROM='hamza@cintara.ai'
# HR pacing digest recipients (POST /pulse/pacing/send), comma-separated.
# export PACING_DIGEST_TO='hamza@cintara.ai,mohita@cintara.ai,alysonclient@cintara.ai'
# Comma-separated allowlist for the Email Reporting "From" picker (no spaces).
export EMAIL_SENDERS='hamza@cintara.ai,mohita@cintara.ai'

# RDS Proxy (tagged for cost allocation; RDS instance is not tagged here)
export RDS_PROXY_NAME=palisade-be-stage-time-doctor-proxy

# Screenshot AI pipeline (DeepSeek vision)
export DEEPSEEK_API_KEY='YOUR_DEEPSEEK_API_KEY'
export SCREENSHOT_AI_ENABLED=false
export SCREENSHOT_AI_BACKFILL_BATCH_SIZE=100
# tesseract (default, local OCR in the worker image) | none
export SCREENSHOT_OCR_PROVIDER=tesseract

# Screenshots older than 30 days → Glacier Instant Retrieval (no delete).
# export SCREENSHOT_COLD_AFTER_DAYS=30
# export SCREENSHOT_COLD_STORAGE_CLASS=GLACIER_IR

# CloudFront in front of screenshot thumbs (HMAC, private bucket). Empty = S3 presign.
# openssl rand -hex 32
# export SCREENSHOT_THUMB_CDN_HMAC_SECRET=

# Leave module — Gmail Domain-Wide Delegation (people-ops inbox scan)
# Same Google SA / DWD setup as AlysonHR. Map AlysonHR env → Pulse SAM:
#
#   AlysonHR GOOGLE_DWD_SERVICE_ACCOUNT_JSON.client_email
#     → GOOGLE_DWD_CLIENT_EMAIL
#   AlysonHR GOOGLE_DWD_SERVICE_ACCOUNT_JSON.private_key  (keep \n escapes)
#     → GOOGLE_DWD_PRIVATE_KEY
#   AlysonHR GOOGLE_WORKSPACE_ADMIN_SUBJECT_EMAIL
#     → GOOGLE_WORKSPACE_ADMIN_SUBJECT_EMAIL + GOOGLE_DWD_SUBJECT
#   AlysonHR GOOGLE_DWD_SERVICE_ACCOUNT_CLIENT_ID
#     → authorize that Client ID in Workspace Admin DWD with gmail.readonly
#
# Workspace Admin → Security → API controls → Domain-wide delegation:
#   Client ID of the service account + scope https://www.googleapis.com/auth/gmail.readonly
# API Lambda needs HTTPS egress (NAT) for Gmail + DeepSeek.
#
# Example (use your real AlysonHR SA — do not commit secrets):
export GOOGLE_DWD_CLIENT_EMAIL='alyson-calendar-sync@YOUR_PROJECT.iam.gserviceaccount.com'
# PEM with literal \n escapes. deploy.sh base64-encodes this for SAM (spaces in
# "BEGIN PRIVATE KEY" otherwise truncate the parameter to "-----BEGIN").
export GOOGLE_DWD_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
export GOOGLE_WORKSPACE_ADMIN_SUBJECT_EMAIL='thirumalai@cintara.ai'
export GOOGLE_DWD_SUBJECT='thirumalai@cintara.ai'
export LEAVE_EMAIL_MAILBOX='people-ops@cintara.ai'
export LEAVE_EMAIL_IMPERSONATE_MAILBOX=false
export LEAVE_EMAIL_HR_REVIEW_ENABLED=false
export LEAVE_CREDIT_HOURS_PER_DAY=7
