export DATABASE_NAME=revclouddb
export DATABASE_USER=alyson_time_doctor_api
export DATABASE_PASSWORD='YOUR_DB_PASSWORD'

# From backend/.env
export INTERNAL_API_KEY='YOUR_INTERNAL_API_KEY'
export COGNITO_USER_POOL_ID=us-west-2_ZL4ElZy4r
