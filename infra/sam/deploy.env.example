export S3_BUCKET_NAME=alyson-pm
# CloudFormation/SAM deploy artifacts (separate prefix from screenshots)
export SAM_DEPLOY_BUCKET=alyson-pm
export SAM_DEPLOY_PREFIX=sam-deploy/alyson-time-doctor-api-dev
export ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,https://palisade-app-qa.vercel.app

# Same subnets as palisade-be-stage-time-doctor-proxy (at least two)
export VPC_SUBNET_IDS=subnet-0d146f3f41150b2a5,subnet-0ddb23264a678e2dc

# Alyson Time Doctor API Lambda security group
export VPC_SECURITY_GROUP_IDS=sg-06839ddc28ac0b659
export VPC_ID=vpc-0b6659ffcf9d60888
