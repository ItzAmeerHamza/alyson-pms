# Copy to deploy.env, fill in values, then: source deploy.env
# Do not commit deploy.env (contains secrets).

export AWS_REGION=us-west-2
export AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID
export STACK_NAME=alyson-time-doctor-api-dev
export ECR_REPO=alyson-time-doctor-api

# RDS Proxy (not direct RDS host)
export DATABASE_HOST=palisade-be-stage-time-doctor-proxy.proxy-ck4yiduvahj7.us-west-2.rds.amazonaws.com
export DATABASE_NAME=revclouddb
export DATABASE_USER=alyson_time_doctor_api
export DATABASE_PASSWORD='YOUR_DB_PASSWORD'

# From backend/.env
export INTERNAL_API_KEY='YOUR_INTERNAL_API_KEY'
export COGNITO_USER_POOL_ID=us-west-2_ZL4ElZy4r
export COGNITO_CLIENT_ID=your_cognito_client_id

export S3_BUCKET_NAME=alyson-pm
# CloudFormation/SAM deploy artifacts (separate prefix from screenshots)
export SAM_DEPLOY_BUCKET=alyson-pm
export SAM_DEPLOY_PREFIX=sam-deploy/alyson-time-doctor-api-dev
export ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,https://palisade-app-qa.vercel.app

# Same subnets as palisade-be-stage-time-doctor-proxy (at least two)
export VPC_SUBNET_IDS=subnet-0d146f3f41150b2a5,subnet-0ddb23264a678e2dc

# Alyson Time Doctor API Lambda security group
export VPC_SECURITY_GROUP_IDS=sg-06839ddc28ac0b659
export VPC_ID=vpc-0b6659ffcf9d60888
export COGNITO_ENDPOINT_SUBNET_IDS=subnet-0ddb23264a678e2dc
