# Production SAM deploy env — copy to deploy.env (do not commit secrets).
# Cognito pool can match QA; DATABASE_HOST must be the PRODUCTION proxy.

export AWS_REGION=us-west-2
export AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID
export STACK_NAME=alyson-time-doctor-api-prod
export ENVIRONMENT_NAME=prod
export ECR_REPO=alyson-time-doctor-api

# PRODUCTION RDS Proxy (not the stage proxy)
export DATABASE_HOST=YOUR_PROD_RDS_PROXY.proxy-XXXX.us-west-2.rds.amazonaws.com
export DATABASE_NAME=revclouddb
export DATABASE_USER=alyson_time_doctor_api
export DATABASE_PASSWORD='YOUR_PROD_DB_PASSWORD'

export INTERNAL_API_KEY='YOUR_PROD_INTERNAL_API_KEY'

# Same Cognito pool as QA is OK if that is your design
export COGNITO_USER_POOL_ID=us-west-2_ZL4ElZy4r
export COGNITO_CLIENT_ID=your_cognito_client_id

export S3_BUCKET_NAME=YOUR_PROD_SCREENSHOTS_BUCKET
export SAM_DEPLOY_BUCKET=YOUR_SAM_ARTIFACT_BUCKET
export SAM_DEPLOY_PREFIX=sam-deploy/alyson-time-doctor-api-prod

# Production web origins only (no localhost unless needed)
export ALLOWED_ORIGINS=https://your-prod-app.example.com

# Prod VPC subnets / Lambda SG that can reach the prod RDS Proxy
export VPC_SUBNET_IDS=subnet-aaa,subnet-bbb
export VPC_SECURITY_GROUP_IDS=sg-prod-lambda
export VPC_ID=vpc-xxxxxxxx

export EMAIL_FROM='your-verified-ses@example.com'
export EMAIL_SENDERS='sender1@example.com,sender2@example.com'

export RDS_PROXY_NAME=YOUR_PROD_RDS_PROXY_NAME

export DEEPSEEK_API_KEY='YOUR_DEEPSEEK_API_KEY'
export SCREENSHOT_AI_ENABLED=false
export SCREENSHOT_AI_BACKFILL_BATCH_SIZE=100
