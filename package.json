{
  "name": "alyson-time-doctor",
  "private": true,
  "version": "1.0.118",
  "description": "Alyson PM monorepo — web portal, desktop agent, and backend",
  "workspaces": [
    "web",
    "desktop-agent",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:desktop": "npm run start -w desktop-agent",
    "dev:backend": "npm run start:dev -w backend",
    "build": "npm run build -w web",
    "build:web": "npm run build -w web",
    "build:dev": "npm run build:dev -w web",
    "lint": "npm run lint -w web",
    "preview": "npm run preview -w web",
    "db:types": "npm run db:types -w web",
    "clean": "npm run clean -w web",
    "clean:all": "npm run clean -w web && npm run clean -w desktop-agent && npm run clean -w backend",
    "deploy:web": "./scripts/deploy-web-updates.sh",
    "test:e2e": "cd tests && playwright test",
    "test:e2e:ui": "cd tests && playwright test --ui",
    "test:e2e:debug": "cd tests && playwright test --debug",
    "test:e2e:headed": "cd tests && playwright test --headed",
    "test:e2e:report": "cd tests && playwright show-report",
    "test:e2e:ci": "cd tests && NODE_ENV=test TEST_MODE=1 playwright test --reporter=list,junit,html --workers=2",
    "pretest:e2e": "cd tests && playwright install --with-deps",
    "test:e2e:install": "cd tests && npm install && npm run install:browsers"
  },
  "engines": {
    "node": ">=20"
  }
}
