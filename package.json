{
  "name": "alyson-pulse",
  "private": true,
  "version": "2.0.0",
  "description": "Alyson Pulse — desktop agent, API, and database",
  "workspaces": [
    "desktop-agent",
    "backend",
    "tasks"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:desktop": "npm run start -w desktop-agent",
    "build:backend": "npm run build -w backend",
    "build:desktop": "npm run build -w desktop-agent",
    "test:backend": "npm run test -w backend",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_pulse_additive.sql",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "tasks:close-sessions": "npm run close-stale-sessions -w tasks",
    "tasks:cleanup-screenshots": "npm run cleanup-screenshots -w tasks",
    "clean:all": "npm run clean -w backend && npm run clean -w desktop-agent 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  }
}
