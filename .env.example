# TimeFlow Environment Variables Template
# Copy this file to .env and fill in your actual values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key
SUPABASE_SERVICE_KEY=your-service-key
NODE_ENV=development

# --- LLM (screenshot AI, Tavilo Coach, leave intake) ---
# Backend reads OPENROUTER_API_KEY from this file or backend/.env.
# Never add LLM API keys under VITE_* — they would ship to the browser.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
