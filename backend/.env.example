# Alyson Pulse API — environment variables

# RDS PostgreSQL — shared Palisade revclouddb
# Local dev: direct RDS host. Lambda/prod: RDS proxy endpoint.
# Credentials: AWS Secrets Manager → rds/palisade-be-stage/alyson-time-doctor
# DATABASE_HOST=palisade-be-stage.ck4yiduvahj7.us-west-2.rds.amazonaws.com
# DATABASE_HOST=palisade-be-stage-time-doctor-proxy.proxy-ck4yiduvahj7.us-west-2.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_USER=alyson_time_doctor_api
# DATABASE_PASSWORD=from-secrets-manager  (quote if password contains #)
# DATABASE_NAME=revclouddb
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# AWS Cognito (JWT validation + admin user provisioning)
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_REGION=us-west-2

# User provisioning (POST /pulse/users) calls cognito-idp:AdminCreateUser.
# In Lambda this uses the function's IAM role. For local dev, set AWS creds with
# AdminCreateUser/AdminDeleteUser permission on the pool (or use AWS_PROFILE).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Desktop agent sync
INTERNAL_API_KEY=generate-a-long-random-string

# S3 screenshots
AWS_S3_SCREENSHOTS_BUCKET=your-bucket
AWS_S3_SCREENSHOTS_PREFIX=alyson-td-screenshots
AWS_REGION=us-west-2

# CORS (Palisade web: local CRA + deployed hosts)
ALLOWED_ORIGINS=http://localhost:3000,https://palisade-app-qa.vercel.app,https://app.palisade.ai,https://app.alyson.ai

# Low-hours / transactional email via SES
# Local: uses SES directly with your AWS credentials + verified EMAIL_FROM.
# Lambda: set SES_EMAIL_FUNCTION_NAME (non-VPC worker) + LAMBDA_VPC_ENDPOINT_URL.
EMAIL_FROM=hamza@cintara.ai
EMAIL_SENDERS=hamza@cintara.ai,mohita@cintara.ai
# SES_EMAIL_FUNCTION_NAME=alyson-time-doctor-ses-email-dev
# LAMBDA_VPC_ENDPOINT_URL=https://vpce-xxxx.lambda.us-west-2.vpce.amazonaws.com

# Screenshot AI — Tesseract OCR in the worker (default). Set none to skip OCR.
# SCREENSHOT_OCR_PROVIDER=tesseract
# TESSERACT_BIN=tesseract

# Server
PORT=3000
NODE_ENV=development
SERVERLESS_MODE=0
