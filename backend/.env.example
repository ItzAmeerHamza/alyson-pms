# Alyson Pulse API — environment variables

# RDS PostgreSQL — shared Palisade revclouddb
# Local dev: direct RDS host. Lambda/prod: RDS proxy endpoint.
# Credentials: AWS Secrets Manager → rds/palisade-be-stage/alyson-time-doctor
# DATABASE_HOST=palisade-be-stage.ck4yiduvahj7.us-west-2.rds.amazonaws.com
# DATABASE_HOST=palisade-be-stage-time-doctor-proxy.proxy-ck4yiduvahj7.us-west-2.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_USER=alyson_time_doctor_api
# DATABASE_PASSWORD=from-secrets-manager  (quote if password contains #)
# DATABASE_NAME=revclouddb
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# AWS Cognito (JWT validation)
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_REGION=us-west-2

# Desktop agent sync
INTERNAL_API_KEY=generate-a-long-random-string

# S3 screenshots
AWS_S3_SCREENSHOTS_BUCKET=your-bucket
AWS_S3_SCREENSHOTS_PREFIX=alyson-td-screenshots
AWS_REGION=us-west-2

# CORS (Loveable + local dev)
ALLOWED_ORIGINS=https://your-loveable-app.lovable.app,http://localhost:5173

# Low-hours emails (optional)
RESEND_API_KEY=
EMAIL_FROM=Alyson Pulse <noreply@yourdomain.com>

# Server
PORT=3000
NODE_ENV=development
SERVERLESS_MODE=0
