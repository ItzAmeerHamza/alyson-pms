{
  "name": "alyson-pulse-api",
  "version": "2.0.0",
  "description": "Alyson Pulse — minimal time tracking API (Lambda-ready)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "build:lambda": "npm run build",
    "docker:lambda": "docker build -f Dockerfile.lambda -t alyson-time-doctor-api:latest .",
    "clean": "rm -rf dist/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1089.0",
    "@aws-sdk/client-lambda": "^3.1089.0",
    "@aws-sdk/client-rekognition": "^3.1083.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1089.0",
    "@aws-sdk/client-sqs": "^3.1082.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^8.1.0",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3",
    "vitest": "^1.0.4"
  }
}
