{
  "name": "time-flow-backend",
  "version": "1.0.0",
  "description": "Time Flow Employee Tracking Backend Service",
  "author": "Time Flow Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:simple": "ts-node src/main-simple.ts",
    "build:simple": "nest build -p tsconfig.json --entry-file main-simple",
    "clean": "rm -rf dist/",
    "lint": "echo 'No ESLint config in backend — skipping' && exit 0",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:e2e": "vitest --config ./test/vitest-e2e.config.ts"
  },
  "keywords": [],
  "dependencies": {
    "@as-integrations/fastify": "^2.1.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/apollo": "^12.0.11",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.11",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/node": "^10.39.0",
    "@slack/webhook": "^7.0.2",
    "@supabase/supabase-js": "^2.49.8",
    "@types/ioredis": "^4.28.10",
    "@types/multer": "^1.4.12",
    "apollo-server-express": "^3.13.0",
    "bull": "^4.16.5",
    "bullmq": "^4.15.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^4.1.0",
    "fastify": "^4.24.3",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^5.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.0.0",
    "nanoid": "^4.0.2",
    "nodemailer": "^6.10.1",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/core": "^1.3.95",
    "@swc/jest": "^0.2.29",
    "@swc/types": "^0.1.5",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vitest": "^1.0.4"
  }
}
