# Copy to desktop-agent/.env (or symlink ../web/.env values for Cognito)
# Must match web portal auth when using RDS + Cognito

VITE_AUTH_PROVIDER=cognito
VITE_COGNITO_REGION=us-west-2
VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_app_client_id
VITE_API_BASE_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3000/sync/desktop-action
# Must match backend/.env INTERNAL_API_KEY. Quote if the value contains #.
INTERNAL_API_KEY="your_backend_INTERNAL_API_KEY"

# Legacy Supabase (only if not using cognito)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
