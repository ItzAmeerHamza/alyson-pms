# TimeFlow Environment Variables Template
# Copy this file to .env and fill in your actual values

# Auth: supabase (legacy) | cognito (RDS + backend API)
VITE_AUTH_PROVIDER=cognito

# Cognito (when VITE_AUTH_PROVIDER=cognito)
VITE_COGNITO_REGION=us-west-2
VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_API_BASE_URL=http://localhost:3000

# Supabase (when VITE_AUTH_PROVIDER=supabase — data still uses Supabase until migrated)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key
SUPABASE_SERVICE_KEY=your-service-key
NODE_ENV=development

# --- DeepSeek / LLM for screenshot AI ---
# Screenshot analysis uses Supabase Edge Function `ai-screenshot-analyzer` (server-side on Supabase).
# Put DEEPSEEK_API_KEY there, NOT in this file: Dashboard → Edge Functions → Secrets, or:
#   supabase secrets set DEEPSEEK_API_KEY=your-key
# Optional vision (DeepSeek multimodal): DEEPSEEK_VISION_MODEL
# Never add LLM API keys under VITE_* — they would ship to the browser.
