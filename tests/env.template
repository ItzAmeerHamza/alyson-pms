# Supabase Test Configuration
# Copy this file to .env and fill in your test Supabase credentials
# Use a separate Supabase project for testing or schema/prefix isolation

# Main Supabase URL for your test project
TEST_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_URL=https://your-test-project.supabase.co

# Anon key for client operations (with RLS)
TEST_SUPABASE_ANON_KEY=your-test-anon-key
VITE_SUPABASE_ANON_KEY=your-test-anon-key

# Service role key for admin operations (bypasses RLS for setup/teardown)
TEST_SUPABASE_SERVICE_KEY=your-test-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Test Configuration
TEST_MODE=1
NODE_ENV=test

# Optional: Custom test timeouts (in milliseconds)
# TEST_TIMEOUT=60000
# TEST_EXPECT_TIMEOUT=10000

# Optional: Test parallelization
# TEST_WORKERS=1

# Optional: Test browser settings
# TEST_HEADLESS=true
# TEST_SLOWMO=0
