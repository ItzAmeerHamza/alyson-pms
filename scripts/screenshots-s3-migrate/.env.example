# Supabase (service role required to read all screenshot rows + storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AWS S3 (do not commit real credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Target: s3://alyson-pm/alyson-td-screenshots/...
S3_BUCKET=alyson-pm
S3_PREFIX=alyson-td-screenshots

# Optional: only migrate rows in this window (ISO 8601)
# SINCE=2024-01-01T00:00:00.000Z
# UNTIL=2026-12-31T23:59:59.999Z

# Audit-critical → WebP lossless vs AVIF lossless (smaller wins)
# AUDIT_LOSSLESS_MODE=never | file | db_privacy | db_distraction
AUDIT_LOSSLESS_MODE=never
# AUDIT_LOSSLESS_IDS_FILE=./audit-screenshot-ids.txt
# AUDIT_DISTRACTION_MIN=75
