# Supabase (service role required to read all screenshot rows + storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AWS S3 (do not commit real credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Target bucket (must match backend AWS_S3_SCREENSHOTS_BUCKET)
S3_BUCKET=alyson-pm
# Default layout: {prefix}/{YYYY}/{MM}/{DD}/organization_{org}/user_{userId}/{screenshot_id}.{ext}
S3_PREFIX=alyson-td-screenshots

# RDS — required when using --update-rds (writes screenshots.s3_key)
DATABASE_HOST=your-instance.us-west-2.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-rds-password
DATABASE_NAME=postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional: only migrate rows in this window (ISO 8601)
# SINCE=2024-01-01T00:00:00.000Z
# UNTIL=2026-12-31T23:59:59.999Z

# Audit-critical → WebP lossless vs AVIF lossless (smaller wins); ignored with --no-transcode
# AUDIT_LOSSLESS_MODE=never | file | db_privacy | db_distraction
AUDIT_LOSSLESS_MODE=never
# AUDIT_LOSSLESS_IDS_FILE=./audit-screenshot-ids.txt
# AUDIT_DISTRACTION_MIN=75
